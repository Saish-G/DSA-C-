#include <iostream>
using namespace std;

#define SIZE 5

int Q[SIZE];
int front = -1, rear = -1;

void enqueue()
{
    int x;

    if (rear == SIZE - 1)
        cout << "Queue Overflow\n";
    else
    {
        cout << "Enter customer number: ";
        cin >> x;

        if (front == -1)
            front = 0;

        rear++;
        Q[rear] = x;
    }
}

void dequeue()
{
    if (front == -1 || front > rear)
        cout << "Queue Underflow\n";
    else
    {
        cout << "Removed: " << Q[front] << endl;
        front++;
    }
}

void display()
{
    if (front == -1 || front > rear)
        cout << "Queue is Empty\n";
    else
    {
        for (int i = front; i <= rear; i++)
            cout << Q[i] << " ";
    }

    cout << endl;
}

int main()
{
    int ch;

    do
    {
        cout << "\n1.Enqueue 2.Dequeue 3.Display 4.Exit\n";
        cin >> ch;

        switch (ch)
        {
            case 1: enqueue(); break;
            case 2: dequeue(); break;
            case 3: display(); break;
        }

    } while (ch != 4);

    return 0;
}
